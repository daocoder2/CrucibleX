ARG BASE_IMAGE=rayproject/ray:2.58.0-py311-gpu
FROM ${BASE_IMAGE}
ARG UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG TORCH_VERSION=2.6.0+cu126

ENV TZ=Asia/Shanghai \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /home/ray/cruciblex
USER root

COPY pyproject.toml README.md ./
RUN uv pip install --system --no-cache-dir --index-url https://download.pytorch.org/whl/cu126 --extra-index-url ${UV_INDEX_URL} --index-strategy unsafe-best-match \
    "torch==${TORCH_VERSION}"

COPY src ./src
COPY examples ./examples
COPY docs ./docs
COPY scripts ./scripts
RUN uv pip install --system --no-cache-dir --index-url ${UV_INDEX_URL} . \
 && chmod -R a+rX /home/ray/cruciblex

CMD ["cx", "doctor"]
