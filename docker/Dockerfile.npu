ARG BASE_IMAGE=swr.cn-south-1.myhuaweicloud.com/ascendhub/cann:8.3.rc1-910b-ubuntu22.04-py3.11
FROM ${BASE_IMAGE}

ARG UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG RAY_VERSION=2.58.0
ARG TORCH_VERSION=2.6.0+cpu
ARG TORCH_NPU_VERSION=2.6.0.post5

ENV TZ=Asia/Shanghai \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/cruciblex

COPY pyproject.toml README.md ./
COPY src ./src
COPY examples ./examples
COPY docs ./docs
COPY scripts ./scripts

RUN python3 -m pip install --no-cache-dir --upgrade -i ${UV_INDEX_URL} uv

RUN uv pip install --system --no-cache-dir --index-url ${UV_INDEX_URL} --index-strategy unsafe-best-match "ray[client]==${RAY_VERSION}" \
 && uv pip install --system --no-cache-dir --index-url https://download.pytorch.org/whl/cpu --extra-index-url ${UV_INDEX_URL} --index-strategy unsafe-best-match "torch==${TORCH_VERSION}" \
 && uv pip install --system --no-cache-dir --index-url ${UV_INDEX_URL} --index-strategy unsafe-best-match "torch-npu==${TORCH_NPU_VERSION}" \
 && uv pip install --system --no-cache-dir --index-url ${UV_INDEX_URL} .

CMD ["cx", "doctor"]
